# ============================================================
#  题库与讲义系统 · 源码仓库忽略清单
#  原则：源码进仓库，运行数据和个人资料一律不进。
# ============================================================

# ---- 依赖（用 npm install 装回来）----
node_modules/

# ---- 打包产物（随时可以重新打）----
dist/
dist-electron/
build/
*.exe
*.dmg
*.zip
!public/skills/**/*.zip
# 注意：app.ico 是打包要用的素材，属于源码，不忽略

# ---- 运行数据：含 API Key 和老师自己的题库，绝不能提交 ----
data/
data-*/
*.db.json
app.lock

# ---- 各平台的临时目录 / 工具缓存 ----
.e2e/
.verify/
.playwright-mcp/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
